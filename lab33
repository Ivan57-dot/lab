okno.geometry('900x750')

ttk.Label(okno, text='Исходный текст:').pack(anchor='w', padx=5)
pole_teksta = ttk.Entry(okno)
pole_teksta.insert(0, 'ЭТОТ_МЕТОД_ЛУЧШЕ_ХАФФМАНА')
pole_teksta.pack(fill='x', padx=5)
ttk.Button(okno, text='Закодировать', command=pri_nazhatii_zakodirovat).pack(pady=3)

tablica_simvolov = sozdat_tablicu(okno, 'Таблица символов',
