import tkinter as tk
from tkinter import ttk, messagebox
import datetime

# Пустые "базы данных" (списки)
clients = []
orders = []
bookings = []
report_text = ""

def login():
    win = tk.Tk(); win.title("Вход"); win.geometry("250x180")
    tk.Label(win, text="Логин:").pack(); l = tk.Entry(win); l.pack()
    tk.Label(win, text="Пароль:").pack(); p = tk.Entry(win, show="*"); p.pack()
    
    def check():
        if l.get() == "admin" and p.get() == "admin123": 
            win.destroy(); main()
        else: 
            messagebox.showerror("Ошибка", "Неверный логин или пароль (admin / admin123)")
            
    tk.Button(win, text="Войти", command=check).pack(pady=10); win.mainloop()

def main():
    root = tk.Tk(); root.title("АИС Бассейн (Демо)"); root.geometry("900x550")
    tabs = ttk.Notebook(root); tabs.pack(fill="both", expand=True)

    # --- 1. КЛИЕНТЫ ---
    f1 = tk.Frame(tabs); tabs.add(f1, text="Клиенты")
    tree1 = ttk.Treeview(f1, columns=("ID", "ФИО", "Email", "Телефон", "Дата рожд."), show="headings")
    for c in ("ID", "ФИО", "Email", "Телефон", "Дата рожд."): tree1.heading(c, text=c)
    tree1.pack(fill="both", expand=True)

    def add_client():
        w = tk.Toplevel(root); w.title("Новый клиент")
        tk.Label(w, text="ФИО:").pack(); e1 = tk.Entry(w); e1.pack()
        tk.Label(w, text="Телефон:").pack(); e2 = tk.Entry(w); e2.pack()
        def save():
            clients.append([len(clients)+1, e1.get(), "test@mail.ru", e2.get(), "01.01.2000"])
            tree1.insert("", "end", values=clients[-1])
            w.destroy()
        tk.Button(w, text="Сохранить", command=save).pack(pady=5)

    def del_client():
        sel = tree1.selection()
        if sel: tree1.delete(sel)

    tk.Button(f1, text="Добавить", command=add_client).pack(pady=5)
    tk.Button(f1, text="Удалить", command=del_client).pack(pady=5)

    # --- 2. АБОНЕМЕНТЫ ---
    f2 = tk.Frame(tabs); tabs.add(f2, text="Абонементы")
    tree2 = ttk.Treeview(f2, columns=("ID", "Клиент", "Абонемент", "Стоимость"), show="headings")
    for c in ("ID", "Клиент", "Абонемент", "Стоимость"): tree2.heading(c, text=c)
    tree2.pack(fill="both", expand=True)

    def add_order():
        w = tk.Toplevel(root); w.title("Оформить абонемент")
        tk.Label(w, text="Клиент:").pack(); cb1 = ttk.Combobox(w, values=["Клиент 1", "Клиент 2"]); cb1.pack()
        tk.Label(w, text="Абонемент:").pack(); cb2 = ttk.Combobox(w, values=["Разовый (500)", "1 месяц (3000)", "3 месяца (8000)"]); cb2.pack()
        def save():
            cost = int(cb2.get().split("(")[1][:-1])
            orders.append([len(orders)+1, cb1.get(), cb2.get().split(" (")[0], cost])
            tree2.insert("", "end", values=orders[-1])
            w.destroy()
        tk.Button(w, text="Оформить", command=save).pack(pady=5)

    tk.Button(f2, text="Оформить", command=add_order).pack(pady=5)

    # --- 3. ЗАПИСИ ---
    f3 = tk.Frame(tabs); tabs.add(f3, text="Записи на сеансы")
    tree3 = ttk.Treeview(f3, columns=("ID", "Клиент", "Дата", "Время"), show="headings")
    for c in ("ID", "Клиент", "Дата", "Время"): tree3.heading(c, text=c)
    tree3.pack(fill="both", expand=True)

    def add_booking():
        w = tk.Toplevel(root); w.title("Записать на сеанс")
        tk.Label(w, text="Клиент:").pack(); cb1 = ttk.Combobox(w, values=["Клиент 1", "Клиент 2"]); cb1.pack()
        tk.Label(w, text="Время:").pack(); cb2 = ttk.Combobox(w, values=["08:00 (дор. 1)", "10:00 (дор. 2)"]); cb2.pack()
        def save():
            bookings.append([len(bookings)+1, cb1.get(), "24.11.2026", cb2.get().split(" (")[0]])
            tree3.insert("", "end", values=bookings[-1])
            w.destroy()
        tk.Button(w, text="Записать", command=save).pack(pady=5)

    tk.Button(f3, text="Записать", command=add_booking).pack(pady=5)

    # --- 4. ОТЧЕТ ---
    f4 = tk.Frame(tabs); tabs.add(f4, text="Отчёт")
    txt = tk.Text(f4); txt.pack(fill="both", expand=True)
    def do_report():
        rev = sum(o[3] for o in orders)
        txt.delete("1.0", tk.END)
        txt.insert(tk.END, f"Выручка: {rev} руб.\nКлиентов: {len(clients)}\nЗаписей: {len(bookings)}")
    
    tk.Button(f4, text="Сформировать", command=do_report).pack(pady=5)

    root.mainloop()

login()