pole_koda.pack(fill='x', padx=5)
ttk.Button(okno, text='Декодировать', command=pri_nazhatii_dekodirovat).pack(pady=3)

tablica_dekodirovaniya = sozdat_tablicu(okno, 'Декодирование',
                                        ('Шаг', 'Символ', 'Новый code', 'Результат'), (50, 80, 450, 250))
metka_rezultata = ttk.Label(okno, font=('Arial', 12, 'bold'))
